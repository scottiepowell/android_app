# ──────────────────────────────────────────────────────────────────────────────
# Base image: Kivy team’s Buildozer runtime
# ──────────────────────────────────────────────────────────────────────────────
FROM ghcr.io/kivy/buildozer:latest

# Use bash with pipefail enabled by default
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

###############################################################################
# 0️⃣  System prerequisites + Android SDK/NDK (run as root)
###############################################################################
USER root

ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH

# One compact layer: tools → SDK cmdline-tools → licences → SDK packages → NDK
RUN bash -euo pipefail && \
    # ----- minimal OS utilities -----
    apt-get update -qq && \
    apt-get install -y --no-install-recommends curl unzip && \
    rm -rf /var/lib/apt/lists/* && \
    \
    # ----- Android cmdline-tools (latest) -----
    mkdir -p $ANDROID_SDK_ROOT/cmdline-tools && \
    curl -sSL \
      https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
      -o /tmp/cli.zip && \
    unzip -q /tmp/cli.zip -d $ANDROID_SDK_ROOT/cmdline-tools && \
    rm /tmp/cli.zip && \
    mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools \
       $ANDROID_SDK_ROOT/cmdline-tools/latest && \
    \
    # legacy “tools/bin” shim so Buildozer can still call sdkmanager
    ln -sf $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager \
            $ANDROID_SDK_ROOT/tools/bin/sdkmanager && \
    \
    # ----- accept licences & install SDK pieces -----
    yes | sdkmanager --licenses >/dev/null && \
    sdkmanager \
      "platform-tools" \
      "platforms;android-34" \
      "build-tools;36.0.0" \
      "ndk;25.2.9519653" && \
    \
    # ----- tidy up permissions -----
    chown -R 1000:1000 $ANDROID_SDK_ROOT

# Expose the NDK location to p4a / Buildozer
ENV ANDROID_NDK_HOME=$ANDROID_SDK_ROOT/ndk/25.2.9519653

###############################################################################
# 1️⃣  Switch to unprivileged user & install Python deps / Buildozer
###############################################################################
USER user
ENV PATH=/home/user/.local/bin:$PATH

RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install --no-cache-dir buildozer==1.*

###############################################################################
# 2️⃣  (Optional) quick smoke-test – comment out to shave a few seconds
###############################################################################
RUN buildozer --version && \
    sdkmanager --list | grep -E "ndk;25\.2\.9519653"

# Build context stays lean because:
#   • everything SDK-related lives in one RUN layer
#   • tmp artefacts are removed immediately
#   • pip cache is discarded with --no-cache-dir
#
# With the NDK pre-baked you should no longer hit unzip exit-code 50
# during CI runs, even on small EBS root volumes.